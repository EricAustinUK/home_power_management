{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cargo",
            "command": "build",
            "problemMatcher": [
                "$rustc"
            ],
            "args": [
                "--target",
                "arm-unknown-linux-musleabihf",
                "--release"
            ],
            "options": {
                "cwd": "${workspaceFolder}/software"
            },
            "group": "build",
            "label": "build software layer"
        },

        {
            "type": "cargo",
            "command": "run",
            "problemMatcher": [
                "$rustc"
            ],
            "options": {
                "cwd": "${workspaceFolder}/ml"
            },
            "group": "build",
            "label": "train ml model"
        },

        

        {
            "type": "shell",
            "dependsOn": ["build software layer", "train ml model"],
            "command": "set -a && source ../.env && set +a && scp target/arm-unknown-linux-musleabihf/release/home_assist ../.env ../ml/output/$MODEL_FILENAME $PI_USER@$PI_HOST:~$PI_USER/ && ssh $PI_USER@$PI_HOST \"chmod +x ~$PI_USER/home_assist\"",
            "options": {
                "cwd": "${workspaceFolder}/software"
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "label": "deploy to pi"
        },

		{
            "type": "shell",
            "dependsOn": "deploy to pi",
            "command": "set -a && source ../.env && set +a && ssh -t $PI_USER@$PI_HOST \"~$PI_USER/home_assist\"",
            "options": {
                "cwd": "${workspaceFolder}/software"
            },
            "problemMatcher": [],
            "group": "test",
            "label": "run on pi"
        }
    ]
}